# Copy to .env (repo root). Used by docker compose and by the API in local dev.

# Comma-separated keys accepted in the X-API-Key header. Empty = no auth (dev only).
API_KEYS=

# PostgreSQL holding client companies, their API keys and usage. Once set, /api/extract always requires a key.
DATABASE_URL=
# Password of the back office at /admin. Empty = login disabled.
ADMIN_PASSWORD=

# Claude fallback: used only when local OCR + rules can't produce a complete result.
ANTHROPIC_API_KEY=
# off | fallback | always
LLM_MODE=fallback
LLM_MODEL=claude-haiku-5-5
# low | medium | high  (higher = slower, more careful)
LLM_EFFORT=low
# Re-read only the lines holding low-confidence values with Claude (fallback mode)
LLM_CHECK_UNCERTAIN=true
# USD per million tokens, used for engine.llm_cost_usd (Claude Haiku 5.5)
LLM_PRICE_INPUT=0.10
LLM_PRICE_OUTPUT=0.50

# OCR: fast first pass, then a more accurate pass only when needed.
# tiny | small
OCR_FAST_MODEL=tiny
# small | medium | none
OCR_ACCURATE_MODEL=small
# Parallel OCR jobs (about number of vCPU / 2)
OCR_CONCURRENCY=2

MAX_UPLOAD_MB=15
CORS_ORIGINS=*

# Local dev only: serve apps/web from the API (path relative to apps/api)
STATIC_DIR=../web
