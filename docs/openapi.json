{
  "openapi": "3.1.0",
  "info": {
    "title": "KYC Extract API",
    "description": "Extraction de données de documents (identité, véhicule, assurance, entreprise, factures, sinistres).\n\nOCR local d'abord ; Claude n'est appelé que pour relire les valeurs douteuses ou les documents non compris.\nAuthentification : header `X-API-Key`. Aucun fichier n'est conservé.\n\nPour décider automatiquement : accepter si `status` = `verified`, ou `complete` sans champ de\n`field_confidence` au niveau `check`/`unknown` ; sinon faire vérifier les champs signalés.",
    "version": "1.2.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/document-types": {
      "get": {
        "summary": "Types reconnus (clé -> libellé)",
        "operationId": "document_types_api_document_types_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Document Types Api Document Types Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/extract": {
      "post": {
        "summary": "Extraire les données d'un document",
        "operationId": "extract_api_extract_post",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_extract_api_extract_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtractResponse"
                }
              }
            }
          },
          "401": {
            "description": "Clé API invalide ou manquante",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Fichier trop volumineux",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "415": {
            "description": "Format non supporté (HEIC, PDF chiffré...)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Paramètre invalide"
          },
          "503": {
            "description": "Vérification de la clé momentanément impossible, réessayer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_extract_api_extract_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "PDF ou image (JPEG, PNG, WEBP, TIFF)"
          },
          "document_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Document Type",
            "description": "Forcer le type (clé de /api/document-types), sinon détection auto"
          },
          "llm": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Llm",
            "description": "off = 100 % local ; fallback (défaut) = LLM seulement si nécessaire ; always"
          },
          "include_text": {
            "type": "boolean",
            "title": "Include Text",
            "description": "Renvoyer le texte OCR brut dans `text`",
            "default": false
          },
          "include_positions": {
            "type": "boolean",
            "title": "Include Positions",
            "description": "Renvoyer l'emplacement de chaque valeur dans `field_positions`",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_extract_api_extract_post"
      },
      "Engine": {
        "properties": {
          "input": {
            "type": "string",
            "title": "Input",
            "description": "pdf, jpeg, png, webp, tiff, bmp"
          },
          "pages": {
            "type": "integer",
            "title": "Pages"
          },
          "ocr_passes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Ocr Passes",
            "description": "native (texte PDF), tiny, small, small:names (relecture ciblée)"
          },
          "llm_used": {
            "type": "boolean",
            "title": "Llm Used"
          },
          "llm_kind": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "lines",
                  "document"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Llm Kind",
            "description": "lines = relecture des seules lignes douteuses ; document = lecture du document complet"
          },
          "llm_model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Llm Model"
          },
          "llm_usage": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LlmUsage"
              },
              {
                "type": "null"
              }
            ]
          },
          "llm_cost_usd": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Llm Cost Usd",
            "description": "Coût IA estimé de cet appel (tarif configuré, en USD)"
          },
          "classification_scores": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Classification Scores"
          }
        },
        "type": "object",
        "required": [
          "input",
          "pages",
          "ocr_passes",
          "llm_used"
        ],
        "title": "Engine"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse"
      },
      "ExtractResponse": {
        "properties": {
          "api_version": {
            "type": "string",
            "title": "Api Version",
            "default": "1.2.0"
          },
          "document_type": {
            "type": "string",
            "enum": [
              "id_card",
              "passport",
              "residence_permit",
              "driving_license",
              "vehicle_registration",
              "insurance_certificate",
              "business_card",
              "kbis",
              "invoice",
              "bank_statement",
              "expert_report",
              "repair_order",
              "insurance_claim",
              "proof_of_address",
              "other",
              "unknown"
            ],
            "title": "Document Type"
          },
          "document_label": {
            "type": "string",
            "title": "Document Label",
            "description": "Libellé français du type"
          },
          "country": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Country",
            "description": "Pays émetteur ISO 3166 alpha-3 si connu"
          },
          "status": {
            "type": "string",
            "enum": [
              "verified",
              "complete",
              "partial"
            ],
            "title": "Status",
            "description": "verified = champs obligatoires présents et checksums OK ; complete = champs obligatoires présents ; partial = il manque des champs obligatoires (voir missing_fields)"
          },
          "fields": {
            "additionalProperties": true,
            "type": "object",
            "title": "Fields",
            "description": "Valeurs extraites. Dates AAAA-MM-JJ, montants en nombre (euros), listes pour emails/phones/categories, legal_representatives = [{role, name}]. Les clés dépendent du type (voir la documentation)."
          },
          "field_sources": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Field Sources",
            "description": "Origine de chaque valeur : mrz, mrz+ocr, ocr, pattern, heuristic, ocr+llm, llm"
          },
          "field_confidence": {
            "additionalProperties": {
              "$ref": "#/components/schemas/FieldConfidence"
            },
            "type": "object",
            "title": "Field Confidence"
          },
          "checks": {
            "additionalProperties": {
              "type": "boolean"
            },
            "type": "object",
            "title": "Checks",
            "description": "Sommes de contrôle effectuées et leur résultat"
          },
          "missing_fields": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Missing Fields"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings",
            "description": "Messages lisibles (corrections LLM, MRZ absente...) - ne pas parser"
          },
          "entities": {
            "additionalProperties": true,
            "type": "object",
            "title": "Entities",
            "description": "Emails, téléphones, IBAN... trouvés dans le texte"
          },
          "mrz": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Mrz"
              },
              {
                "type": "null"
              }
            ]
          },
          "engine": {
            "$ref": "#/components/schemas/Engine"
          },
          "timings_ms": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Timings Ms"
          },
          "text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Text",
            "description": "Texte OCR brut (si include_text=true)"
          },
          "page_rotations": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Page Rotations",
            "description": "Par page, angle (0, 90, 180, 270) dont il faut la tourner dans le sens horaire pour la lire à l'endroit"
          },
          "field_positions": {
            "anyOf": [
              {
                "additionalProperties": {
                  "$ref": "#/components/schemas/FieldPosition"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Field Positions",
            "description": "Si include_positions=true : emplacement de chaque valeur retrouvée telle qu'imprimée, dans la page telle qu'envoyée (avant rotation), origine en haut à gauche. Absent pour une valeur reformatée ou déduite."
          }
        },
        "type": "object",
        "required": [
          "document_type",
          "document_label",
          "status",
          "fields",
          "field_sources",
          "checks",
          "missing_fields",
          "warnings",
          "engine",
          "timings_ms"
        ],
        "title": "ExtractResponse",
        "example": {
          "checks": {
            "mrz_birth_date": true,
            "mrz_document_number": true
          },
          "country": "FRA",
          "document_label": "Carte nationale d'identité",
          "document_type": "id_card",
          "engine": {
            "input": "jpeg",
            "llm_used": false,
            "ocr_passes": [
              "tiny"
            ],
            "pages": 1
          },
          "entities": {},
          "field_confidence": {
            "birth_place": {
              "level": "high",
              "score": 0.991
            },
            "surname": {
              "level": "verified",
              "score": 1.0
            }
          },
          "field_sources": {
            "birth_date": "mrz",
            "birth_place": "ocr",
            "surname": "mrz+ocr"
          },
          "fields": {
            "birth_date": "1988-07-14",
            "birth_place": "LYON 3E (69)",
            "document_number": "X4RTBPFW4",
            "expiry_date": "2031-02-11",
            "given_names": "Élodie, Françoise",
            "surname": "MARTIN"
          },
          "missing_fields": [],
          "status": "verified",
          "timings_ms": {
            "ingest": 7,
            "ocr_fast": 430,
            "total": 440
          },
          "warnings": []
        }
      },
      "FieldConfidence": {
        "properties": {
          "score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score",
            "description": "Score de lecture du caractère le plus faible de la valeur (0-1). null si la valeur est reformatée/déduite ou lue par le LLM."
          },
          "level": {
            "type": "string",
            "enum": [
              "verified",
              "high",
              "confirmed",
              "llm",
              "check",
              "unknown"
            ],
            "title": "Level",
            "description": "verified = prouvé par checksum (MRZ, SIREN, SIRET, IBAN, totaux) ; high = tous les caractères ≥ 0,97 ; confirmed = caractère douteux mais le LLM a relu la ligne à l'identique ; llm = valeur corrigée/ajoutée par le LLM ; check = au moins un caractère < 0,97 ; unknown = valeur non retrouvée telle qu'imprimée (reformatée ou déduite). À faire vérifier par un humain : check et unknown."
          }
        },
        "type": "object",
        "required": [
          "score",
          "level"
        ],
        "title": "FieldConfidence"
      },
      "FieldPosition": {
        "properties": {
          "page": {
            "type": "integer",
            "title": "Page",
            "description": "Numéro de page (1 = première)"
          },
          "x": {
            "type": "integer",
            "title": "X",
            "description": "Bord gauche, en millièmes de la largeur de la page"
          },
          "y": {
            "type": "integer",
            "title": "Y",
            "description": "Bord haut, en millièmes de la hauteur de la page"
          },
          "width": {
            "type": "integer",
            "title": "Width",
            "description": "Largeur, en millièmes de la largeur de la page"
          },
          "height": {
            "type": "integer",
            "title": "Height",
            "description": "Hauteur, en millièmes de la hauteur de la page"
          }
        },
        "type": "object",
        "required": [
          "page",
          "x",
          "y",
          "width",
          "height"
        ],
        "title": "FieldPosition"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "starting"
            ],
            "title": "Status"
          },
          "api_version": {
            "type": "string",
            "title": "Api Version",
            "default": "1.2.0"
          },
          "auth": {
            "type": "boolean",
            "title": "Auth",
            "description": "Une clé X-API-Key est exigée"
          },
          "llm": {
            "type": "string",
            "title": "Llm",
            "description": "off | fallback | always"
          },
          "llm_model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Llm Model"
          }
        },
        "type": "object",
        "required": [
          "status",
          "auth",
          "llm",
          "llm_model"
        ],
        "title": "Health"
      },
      "LlmUsage": {
        "properties": {
          "input_tokens": {
            "type": "integer",
            "title": "Input Tokens"
          },
          "output_tokens": {
            "type": "integer",
            "title": "Output Tokens"
          }
        },
        "type": "object",
        "required": [
          "input_tokens",
          "output_tokens"
        ],
        "title": "LlmUsage"
      },
      "Mrz": {
        "properties": {
          "format": {
            "type": "string",
            "title": "Format",
            "description": "TD1, TD2, TD3, FR_CNI (ancien modèle) ou EU_DL"
          },
          "lines": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Lines"
          },
          "valid": {
            "type": "boolean",
            "title": "Valid",
            "description": "Toutes les sommes de contrôle ICAO sont correctes"
          }
        },
        "type": "object",
        "required": [
          "format",
          "lines",
          "valid"
        ],
        "title": "Mrz"
      }
    }
  }
}